@page "/"
@inject IMetadataProviderFactory MetadataProviderFactory
@inject QueryTabState TabState
@inject IJSRuntime JS

<PageTitle>DevelopTi</PageTitle>

<div class="workspace-shell">
    <aside class="workspace-tree" id="workspace-tree">
        <DatabaseTree OnOpenTable="HandleOpenTable" OnNewQuery="HandleNewQuery" OnProfilesChanged="HandleProfilesChanged" />
    </aside>
    <div class="workspace-resizer-v" id="tree-resizer">
        <button class="resizer-toggle" id="tree-toggle" title="Esconder/mostrar árvore de conexões">‹</button>
    </div>
    <section class="workspace-main">
        <QueryTabsPanel @ref="_queryTabsPanel" />
    </section>
</div>

@code {
    private QueryTabsPanel? _queryTabsPanel;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("developtiResizer.initHorizontal", "tree-resizer", "workspace-tree", new { min = 200, max = 520 });
            await JS.InvokeVoidAsync("developtiResizer.initCollapseToggle", "tree-toggle", "workspace-tree", new { defaultWidth = 340 });
        }
    }

    private void HandleOpenTable((DevelopTi.Data.Models.ConnectionProfile Profile, string? Database, string Schema, string Table) args)
    {
        var provider = MetadataProviderFactory.GetProvider(args.Profile.Kind);
        var sql = provider.BuildSelectAllSql(args.Database, args.Schema, args.Table, 200);
        TabState.AddTab(args.Profile.Id, args.Table, sql);
    }

    private void HandleNewQuery(DevelopTi.Data.Models.ConnectionProfile profile)
    {
        var count = TabState.Tabs.Count(t => t.ConnectionProfileId == profile.Id) + 1;
        TabState.AddTab(profile.Id, $"{profile.Name}-{count}");
    }

    private async Task HandleProfilesChanged()
    {
        if (_queryTabsPanel is not null)
        {
            await _queryTabsPanel.RefreshProfilesAsync();
        }
    }
}
